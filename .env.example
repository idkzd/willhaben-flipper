# OpenRouter — models are tried in order (first success wins).
# The first one is multimodal (sees the advert photo); the rest are text-only
# fallbacks used when it is rate-limited/unavailable.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free,z-ai/glm-5.2:free,poolside/laguna-s-2.1:free

# Which of the models above can accept images (receives the first photo)
VISION_MODELS=dots-studio/dots-3-note-preview:free,mimo-v2.5:free

# Telegram bot token. Anyone who sends /start to this bot gets the matches.
TELEGRAM_BOT_TOKEN=123456789:AA...

# willhaben search URL (already filtered to Wien via areaId=900)
WILLHABEN_URL=https://www.willhaben.at/iad/kaufen-und-verkaufen/zu-verschenken/marktplatz?sfId=188bc8f2-24d3-4bc4-9a7c-acead7e55731&rows=30&isNavigation=true&areaId=900&page=1&PRICE_FROM=0&PRICE_TO=0

# How many pages to scan (newest ads are on page 1)
PAGES=1

# Minimum resale score (0-10) to trigger a Telegram message
MIN_RESALE_SCORE=7

# Max new ads to evaluate per run (cost control)
MAX_LLM_CALLS_PER_RUN=30

# Pause (seconds) between LLM calls to avoid free-tier rate limits
LLM_REQUEST_DELAY=3

# Polling interval (seconds) when running without --once / --loop
LOOP_INTERVAL=10

# Second provider — fallback when all OpenRouter models fail.
# TokenHarbor (mimo-v2.5:free) is also vision-capable.
SECOND_PROVIDER_BASE_URL=https://tokenharbor.ai/v1
SECOND_PROVIDER_API_KEY=thk_live_...
SECOND_PROVIDER_MODEL=mimo-v2.5:free
